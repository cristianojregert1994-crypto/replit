modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unar"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LoveBolt mockup preview"

[[workflows.workflow]]
name = "LoveBolt mockup preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && PORT=5000 BASE_PATH=/ npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
isCanvasWorkflow = true
